<UserControl x:Class="SRS3.E2E.PanelControl.E2ERxControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="Microsoft YaHei UI" FontSize="11" Background="#F3F4F5" Foreground="#25292D"
 SnapsToDevicePixels="True" UseLayoutRounding="True"
 TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
 <UserControl.Resources>
  <Style TargetType="ComboBox">
   <Setter Property="Height" Value="27"/><Setter Property="Padding" Value="7,1"/>
   <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#A7AFB5"/>
  </Style>
  <Style x:Key="SectionHeader" TargetType="Border">
   <Setter Property="Height" Value="27"/><Setter Property="Background" Value="#E9EBED"/>
   <Setter Property="BorderBrush" Value="#B6BDC2"/><Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style x:Key="ColumnHeader" TargetType="DataGridColumnHeader">
   <Setter Property="Height" Value="25"/><Setter Property="Background" Value="#E6E8EA"/>
   <Setter Property="Foreground" Value="#30353A"/><Setter Property="BorderBrush" Value="#C7CCD0"/>
   <Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Padding" Value="6,0"/>
  </Style>
  <Style x:Key="TableRow" TargetType="DataGridRow">
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#2B3034"/>
   <Style.Triggers>
    <Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="#F8F9F9"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DCEAF3"/><Setter Property="Foreground" Value="#193E56"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="Table" TargetType="DataGrid">
   <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/>
   <Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="CanUserReorderColumns" Value="False"/>
   <Setter Property="CanUserResizeRows" Value="False"/><Setter Property="GridLinesVisibility" Value="All"/>
   <Setter Property="HorizontalGridLinesBrush" Value="#D9DDE0"/><Setter Property="VerticalGridLinesBrush" Value="#E1E4E6"/>
   <Setter Property="BorderBrush" Value="#B6BDC2"/><Setter Property="BorderThickness" Value="1,0,1,1"/>
   <Setter Property="ColumnHeaderStyle" Value="{StaticResource ColumnHeader}"/><Setter Property="RowStyle" Value="{StaticResource TableRow}"/>
   <Setter Property="AlternationCount" Value="2"/><Setter Property="SelectionUnit" Value="FullRow"/>
   <Setter Property="SelectionMode" Value="Single"/><Setter Property="HeadersVisibility" Value="Column"/>
  </Style>
  <Style x:Key="MetricLabel" TargetType="TextBlock">
   <Setter Property="FontSize" Value="9"/><Setter Property="Foreground" Value="#697178"/>
  </Style>
  <Style x:Key="MetricValue" TargetType="TextBlock">
   <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,3,0,0"/>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="MinWidth" Value="110"/><Setter Property="Height" Value="28"/>
   <Setter Property="Padding" Value="12,3"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
 </UserControl.Resources>

 <!-- Native CANoe layout: no oversized fixed canvas and no whole-panel scroll viewer. -->
 <Grid Margin="8">
  <Grid.RowDefinitions>
   <RowDefinition Height="46"/><RowDefinition Height="7"/>
   <RowDefinition Height="40"/><RowDefinition Height="7"/>
   <RowDefinition Height="27"/><RowDefinition Height="118"/><RowDefinition Height="7"/>
   <RowDefinition Height="55"/><RowDefinition Height="7"/>
   <RowDefinition Height="*"/><RowDefinition Height="7"/><RowDefinition Height="22"/>
  </Grid.RowDefinitions>

  <Border Grid.Row="0" Background="White" BorderBrush="#ADB5BA" BorderThickness="1">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Background="#526B7B"/>
    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
     <TextBlock Text="SRS3 E2E Rx Monitor" FontSize="15" FontWeight="SemiBold" LineHeight="18"/>
     <TextBlock Text="Profile G / P01 · 只监听，不发送报文" Margin="0,2,0,0" FontSize="9" Foreground="#69737A" LineHeight="12"/>
    </StackPanel>
    <Border Grid.Column="2" Background="{Binding BridgeStatusBackground}" BorderBrush="{Binding BridgeStatusBorder}"
            BorderThickness="1" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center">
     <TextBlock Text="{Binding BridgeStatus}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding BridgeStatusForeground}"/>
    </Border>
   </Grid>
  </Border>

  <Border Grid.Row="2" Background="White" BorderBrush="#B6BDC2" BorderThickness="1" Padding="9,6">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="65"/><ColumnDefinition Width="155"/><ColumnDefinition Width="22"/>
     <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <TextBlock Text="接收通道" VerticalAlignment="Center" Foreground="#4B5359"/>
    <ComboBox Grid.Column="1" ItemsSource="{Binding NetworkOptions}" SelectedItem="{Binding CurrentNetwork}"/>
    <TextBlock Grid.Column="3" Text="{Binding GroupSummaryText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
    <TextBlock Grid.Column="5" Text="选择 Group 查看最后接收帧" VerticalAlignment="Center" FontSize="9.5" Foreground="#737B81"/>
   </Grid>
  </Border>

  <Border Grid.Row="4" Style="{StaticResource SectionHeader}">
   <Grid Margin="8,0"><TextBlock Text="接收对象" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <TextBlock Text="每个 E2E Group 独立判定" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="9" Foreground="#70787E"/>
   </Grid>
  </Border>
  <DataGrid x:Name="GroupsGrid" Grid.Row="5" Style="{StaticResource Table}" ItemsSource="{Binding VisibleGroups}"
            SelectedItem="{Binding CurrentGroup}" IsReadOnly="True" RowHeight="23">
   <DataGrid.Columns>
    <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="28"/>
    <DataGridTextColumn Header="CAN ID" Binding="{Binding CanId}" Width="58"/>
    <DataGridTextColumn Header="周期" Binding="{Binding TimingText}" Width="60"/>
    <DataGridTextColumn Header="受保护 Group" Binding="{Binding Group}" Width="148"/>
    <DataGridTextColumn Header="网络报文" Binding="{Binding Frame}" Width="155"/>
    <DataGridTextColumn Header="DLC" Binding="{Binding Dlc}" Width="42"/>
    <DataGridTextColumn Header="DataID" Binding="{Binding DataIdText}" Width="62"/>
    <DataGridTextColumn Header="MaxΔ" Binding="{Binding MaxDelta}" Width="48"/>
    <DataGridTextColumn Header="判定状态" Binding="{Binding StateText}" Width="78">
     <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding StateBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
    <DataGridTextColumn Header="帧数" Binding="{Binding Frames}" Width="52"/>
    <DataGridTextColumn Header="Age" Binding="{Binding AgeMs}" Width="130"/>
   </DataGrid.Columns>
  </DataGrid>

  <Border Grid.Row="7" Background="White" BorderBrush="#B6BDC2" BorderThickness="1">
   <UniformGrid Columns="7">
    <Border BorderBrush="#D3D7DA" BorderThickness="0,0,1,0" Padding="8,7"><StackPanel><TextBlock Text="判定" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedStateText}" Style="{StaticResource MetricValue}" Foreground="{Binding SelectedStateBrush}"/></StackPanel></Border>
    <Border BorderBrush="#D3D7DA" BorderThickness="0,0,1,0" Padding="8,7"><StackPanel><TextBlock Text="Counter / Δ" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding CounterText}" Style="{StaticResource MetricValue}"/></StackPanel></Border>
    <Border BorderBrush="#D3D7DA" BorderThickness="0,0,1,0" Padding="8,7"><StackPanel><TextBlock Text="CRC Rx / Calc" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding CrcText}" Style="{StaticResource MetricValue}" Foreground="{Binding CrcBrush}"/></StackPanel></Border>
    <Border BorderBrush="#D3D7DA" BorderThickness="0,0,1,0" Padding="8,7"><StackPanel><TextBlock Text="Update Bit" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding UbText}" Style="{StaticResource MetricValue}"/></StackPanel></Border>
    <Border BorderBrush="#D3D7DA" BorderThickness="0,0,1,0" Padding="8,7"><StackPanel><TextBlock Text="Age / Timeout" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding AgeText}" Style="{StaticResource MetricValue}"/></StackPanel></Border>
    <Border BorderBrush="#D3D7DA" BorderThickness="0,0,1,0" Padding="8,7"><StackPanel><TextBlock Text="有效 / 异常" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding CountText}" Style="{StaticResource MetricValue}"/></StackPanel></Border>
    <Border Padding="8,7"><StackPanel><TextBlock Text="字段位置" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding LayoutText}" Style="{StaticResource MetricValue}" FontSize="9" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
   </UniformGrid>
  </Border>

  <!-- Same interaction model as PDU Interactive Generator: switch the lower workspace by tabs. -->
  <TabControl x:Name="DetailTabs" Grid.Row="9" Background="White" BorderBrush="#B6BDC2">
   <TabItem x:Name="ElementsTab" Header="应用数据元素">
    <Grid Margin="5"><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="最后接收 Raw 解码；CRC 输入元素按名称排序" Margin="5,0" VerticalAlignment="Center" FontSize="9" Foreground="#70787E"/>
     <DataGrid x:Name="ElementsGrid" Grid.Row="1" Style="{StaticResource Table}" ItemsSource="{Binding ElementRows}" IsReadOnly="True" RowHeight="25">
      <DataGrid.Columns>
       <DataGridTextColumn Header="元素" Binding="{Binding Name}" Width="145"/>
       <DataGridTextColumn Header="DBC 信号" Binding="{Binding Signal}" Width="235"/>
       <DataGridTextColumn Header="Raw（十进制 / 十六进制）" Binding="{Binding RawText}" Width="190"/>
       <DataGridTextColumn Header="物理位布局" Binding="{Binding LayoutText}" Width="295"/>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </TabItem>
   <TabItem x:Name="PayloadTab" Header="Raw Payload">
    <Grid Margin="5"><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="{Binding PayloadSummaryText}" Margin="5,0" VerticalAlignment="Center" FontSize="9" Foreground="#70787E"/>
     <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                   Background="White" BorderBrush="#B6BDC2" BorderThickness="1" Padding="4">
      <ItemsControl x:Name="PayloadItems" ItemsSource="{Binding PayloadBytes}">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding DataContext.PayloadColumnCount, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate>
        <Border Height="42" Background="#FCFCFC" BorderBrush="{Binding RoleBrush}" BorderThickness="1" Margin="2" Padding="5,2">
         <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="{Binding IndexText}" FontSize="8" Foreground="#6B747A"/>
          <TextBlock Grid.Row="1" Text="{Binding ValueText}" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="2" Text="{Binding DisplayRole}" FontSize="7.5" FontWeight="SemiBold" Foreground="{Binding RoleBrush}" HorizontalAlignment="Center"/>
         </Grid>
        </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </ScrollViewer>
    </Grid>
   </TabItem>
  </TabControl>

  <Border Grid.Row="11" Background="White" BorderBrush="#B6BDC2" BorderThickness="1">
   <TextBlock Text="{Binding FooterText}" Margin="7,3" FontSize="9" Foreground="{Binding FooterBrush}" TextTrimming="CharacterEllipsis"/>
  </Border>
 </Grid>
</UserControl>
