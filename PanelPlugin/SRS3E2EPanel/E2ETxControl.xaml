<UserControl x:Class="SRS3.E2E.PanelControl.E2ETxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="540"
             FontFamily="Segoe UI"
             FontSize="11"
             Background="#F2F4F6"
             Foreground="#25292D"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#25292D" />
            <Setter Property="BorderBrush" Value="#AEB7BF" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#B7C2CC" />
        </Style>

        <Style x:Key="CommandButton" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Background" Value="#F8F9FA" />
            <Setter Property="BorderBrush" Value="#9FAAB3" />
            <Setter Property="Foreground" Value="#30373D" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF2F5" />
                    <Setter Property="BorderBrush" Value="#6F7C86" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#98A1A9" />
                    <Setter Property="Background" Value="#ECEFF1" />
                    <Setter Property="BorderBrush" Value="#C7CDD2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryCommandButton" TargetType="Button" BasedOn="{StaticResource CommandButton}">
            <Setter Property="Background" Value="#2F6F9F" />
            <Setter Property="BorderBrush" Value="#245A82" />
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#285F88" />
                    <Setter Property="BorderBrush" Value="#204F71" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#98A1A9" />
                    <Setter Property="Background" Value="#ECEFF1" />
                    <Setter Property="BorderBrush" Value="#C7CDD2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TableHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E9EDF0" />
            <Setter Property="Foreground" Value="#343A40" />
            <Setter Property="BorderBrush" Value="#CDD3D8" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="TableRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#2C3136" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F7F8F9" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCEAF5" />
                    <Setter Property="Foreground" Value="#183A54" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TableGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HorizontalGridLinesBrush" Value="#DDE1E4" />
            <Setter Property="VerticalGridLinesBrush" Value="#E3E6E8" />
            <Setter Property="BorderBrush" Value="#B8C0C7" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource TableHeader}" />
            <Setter Property="RowStyle" Value="{StaticResource TableRow}" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="EnableRowVirtualization" Value="True" />
        </Style>

        <Style x:Key="StatusCard" TargetType="Border">
            <Setter Property="Background" Value="#F7F9FB" />
            <Setter Property="BorderBrush" Value="#CAD3DC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Margin" Value="2" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="43" />
            <RowDefinition Height="112" />
            <RowDefinition Height="4" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="82" />
            <RowDefinition Height="21" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#B8C0C7" BorderThickness="1" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Background="#2F6F9F" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="SRS3 E2E Tx" FontSize="15.5" FontWeight="SemiBold" Foreground="#20252A" />
                    <TextBlock Text="UI v1.6.1 | CAN1 Tx | Profile G/P01 | 多PDU独立控制" Margin="12,3,0,0" FontSize="9.5" Foreground="#66717B" />
                </StackPanel>
                <Border Grid.Column="2" Background="{Binding BridgeStatusBackground}" BorderBrush="{Binding BridgeStatusBorder}" BorderThickness="1" Padding="9,3" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,7,0">
                    <TextBlock Text="{Binding BridgeStatus}" FontSize="9.5" FontWeight="SemiBold" Foreground="{Binding BridgeStatusForeground}" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#AAB6C1" BorderThickness="1,0,1,1" Padding="7,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*" /><ColumnDefinition Width="7" />
                    <ColumnDefinition Width="1.05*" /><ColumnDefinition Width="7" />
                    <ColumnDefinition Width="0.78*" /><ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="9" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="9" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="PDU" FontSize="8.5" Foreground="#5F7182" />
                    <ComboBox ItemsSource="{Binding Pdus}" SelectedItem="{Binding CurrentPdu, Mode=TwoWay}" DisplayMemberPath="DisplayName" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="发送模式" FontSize="8.5" Foreground="#5F7182" />
                    <ComboBox ItemsSource="{Binding OverrideOptions}" DisplayMemberPath="Text" SelectedValuePath="Value" SelectedValue="{Binding OverrideMode, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="UB模式" FontSize="8.5" Foreground="#5F7182" />
                    <ComboBox ItemsSource="{Binding UbOptions}" DisplayMemberPath="Text" SelectedValuePath="Value" SelectedValue="{Binding UbMode, Mode=TwoWay}" />
                </StackPanel>
                <CheckBox Grid.Column="6" Content="自动保护" ToolTip="发送前由CAPL根据最终Raw计算Counter、CRC和UB" IsChecked="{Binding AutoProtect}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                <CheckBox Grid.Column="8" Content="发送使能" ToolTip="只解锁Panel发送命令；勾选本身不会发送PDU" IsChecked="{Binding GlobalEnable, Mode=OneWay}" IsEnabled="{Binding CanToggleGlobal}" Click="GlobalEnable_Click" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                <Button Grid.Column="10" Content="执行当前" ToolTip="只启动当前所选PDU；其他已运行PDU保持不变" Style="{StaticResource PrimaryCommandButton}" IsEnabled="{Binding CanApply}" Click="ApplyButton_Click" VerticalAlignment="Bottom" />
                <Button Grid.Column="12" Content="停止当前" ToolTip="只取消当前所选PDU的单帧或连续发送许可" Style="{StaticResource CommandButton}" IsEnabled="{Binding CanRestore}" Click="RestoreButton_Click" VerticalAlignment="Bottom" />
                <Button Grid.Column="14" Content="停止全部" ToolTip="安全停止全部5个受控PDU" Style="{StaticResource CommandButton}" IsEnabled="{Binding CanStopAll}" Click="StopAllButton_Click" VerticalAlignment="Bottom" />
            </Grid>
        </Border>

        <DataGrid Grid.Row="2"
                  Style="{StaticResource TableGrid}"
                  ItemsSource="{Binding Pdus}"
                  SelectedItem="{Binding CurrentPdu, Mode=TwoWay}"
                  IsReadOnly="True"
                  ColumnHeaderHeight="20"
                  RowHeight="18"
                  FontSize="9.5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="34" />
                <DataGridTextColumn Header="CAN ID" Binding="{Binding CanId}" Width="60" />
                <DataGridTextColumn Header="触发" Binding="{Binding TriggerText}" Width="70" />
                <DataGridTextColumn Header="周期" Binding="{Binding TimingText}" Width="94" />
                <DataGridTextColumn Header="受保护PDU / 组" Binding="{Binding Group}" Width="160" />
                <DataGridTextColumn Header="网络报文" Binding="{Binding Frame}" Width="180" />
                <DataGridTextColumn Header="DLC" Binding="{Binding Length}" Width="42" />
                <DataGridTextColumn Header="DataID" Binding="{Binding DataIdHex}" Width="68" />
                <DataGridTemplateColumn Header="发送状态" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><TextBlock Text="{Binding SendStatusText}" Foreground="{Binding SendStatusForeground}" FontWeight="SemiBold" Margin="4,0" /></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="#C4CCD4" />

        <Border Grid.Row="4" Background="#F7F7F7" BorderBrush="#AEB3B8" BorderThickness="1,0,1,1" Padding="5,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="2.4*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#F8FBFD" BorderBrush="#5B8DB3" BorderThickness="1" Padding="6,2" Margin="1,0">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="状态  " FontSize="8" Foreground="#59646D" VerticalAlignment="Center" /><TextBlock Text="{Binding ProtectionState}" FontWeight="Bold" Foreground="#285E87" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /></StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#FAFBFC" BorderBrush="#AEB6BD" BorderThickness="1" Padding="6,2" Margin="1,0">
                    <StackPanel><TextBlock Text="COUNTER / 计数器" FontSize="7.5" Foreground="#666B70" /><TextBlock Text="{Binding CounterText}" FontSize="11" FontWeight="Bold" Foreground="#202326" /></StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#FFF8F7" BorderBrush="#C65A50" BorderThickness="1" Padding="6,2" Margin="1,0">
                    <StackPanel><TextBlock Text="CRC-8" FontSize="7.5" Foreground="#8F3D36" /><TextBlock Text="{Binding CrcText}" FontSize="11" FontWeight="Bold" Foreground="#A83A31" /></StackPanel>
                </Border>
                <Border Grid.Column="3" Background="#FFF9E8" BorderBrush="#D7AB32" BorderThickness="1" Padding="6,2" Margin="1,0">
                    <StackPanel><TextBlock Text="UB / 更新位" FontSize="7.5" Foreground="#725A15" /><TextBlock Text="{Binding UpdateBitText}" FontSize="10.5" FontWeight="Bold" Foreground="#5C4914" /></StackPanel>
                </Border>
                <Border Grid.Column="4" Background="#FAFBFC" BorderBrush="#AEB6BD" BorderThickness="1" Padding="6,2" Margin="1,0">
                    <StackPanel><TextBlock Text="DATA ID · CRC输入" FontSize="7.5" Foreground="#666B70" /><TextBlock Text="{Binding DataIdText}" FontSize="10.5" FontWeight="Bold" Foreground="#202326" /></StackPanel>
                </Border>
                <Border Grid.Column="5" Background="#F7F9FB" BorderBrush="#C6D0D9" BorderThickness="1" Padding="6,2" Margin="1,0">
                    <StackPanel><TextBlock Text="物理字段位置" FontSize="7.5" Foreground="#637587" /><TextBlock Text="{Binding E2eLayoutText}" FontSize="8.5" Foreground="#354D61" TextTrimming="CharacterEllipsis" /></StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="5" Background="White" BorderBrush="#AAB6C1" BorderThickness="1,0,1,1">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="24" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Background="#ECEFF1" BorderBrush="#C8CCCF" BorderThickness="0,0,0,1" Padding="7,3">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="应用信号" FontWeight="SemiBold" Foreground="#202326" />
                        <TextBlock Grid.Column="1" Text="物理值 / 枚举  →  最终Raw  →  E2E保护" FontSize="8.5" Foreground="#64798B" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <DataGrid Grid.Row="1" Style="{StaticResource TableGrid}" ItemsSource="{Binding SignalRows}" IsReadOnly="False" ColumnHeaderHeight="20" RowHeight="28" FontSize="9.2">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="信号" Width="170" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="3,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding DbcSignal}" FontSize="7.5" Foreground="#748596" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="物理值 / 枚举" Width="205">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="2"><TextBox Text="{Binding PhysicalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UsePhysical}" Visibility="{Binding IsNumeric, Converter={StaticResource BoolToVisibility}}" /><ComboBox ItemsSource="{Binding EnumOptions}" DisplayMemberPath="Text" SelectedValuePath="Value" SelectedValue="{Binding RawValue, Mode=TwoWay}" IsEnabled="{Binding UsePhysical}" Visibility="{Binding IsEnum, Converter={StaticResource BoolToVisibility}}" /></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="最终Raw" Width="88"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Margin="2" Text="{Binding RawValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseRaw}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn Header="单位" Binding="{Binding UnitText}" Width="55" IsReadOnly="True" />
                        <DataGridTextColumn Header="范围 / 类型" Binding="{Binding RangeText}" Width="145" IsReadOnly="True" />
                        <DataGridCheckBoxColumn Header="使用Raw" Binding="{Binding UseRaw, Mode=TwoWay}" Width="70" />
                        <DataGridTextColumn Header="有效性" Binding="{Binding ValidityText}" Width="76" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="6" Background="White" BorderBrush="#AAB6C1" BorderThickness="1,0,1,1" Padding="6,3">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="最终发送PAYLOAD · BYTE 0 → 7" FontWeight="Bold" FontSize="9.5" Foreground="#243B50" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="CAPL Tx钩子输出" Margin="8,0,0,0" FontSize="8" Foreground="#66798A" VerticalAlignment="Center" />
                </Grid>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding PayloadBytes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" Columns="8" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding RoleBackground}" BorderBrush="{Binding RoleBorder}" BorderThickness="1" Margin="0" Padding="3,1">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="12" /><RowDefinition Height="*" /><RowDefinition Height="13" /></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Index, StringFormat='BYTE {0}'}" FontSize="7.5" Foreground="{Binding RoleForeground}" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Text="{Binding HexValue}" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="#152A3B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding RoleText}" FontSize="8" FontWeight="Bold" Foreground="{Binding RoleForeground}" />
                                        <TextBlock Text="{Binding RoleDetail, StringFormat='  {0}'}" FontSize="7" Foreground="#6B7B89" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <Border Grid.Row="7" Background="#FAFBFC" BorderBrush="#AAB6C1" BorderThickness="1,0,1,1" Padding="6,2">
            <TextBlock Text="{Binding FooterMessage}" Foreground="{Binding FooterForeground}" FontSize="8.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
